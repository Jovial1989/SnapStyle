# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=looktok-assets
R2_PUBLIC_BASE=https://cdn.looktok.co

# Supabase — service role: this process writes model3d_url on behalf of the system
SUPABASE_URL=https://tnirnwapfgckfypvtooj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ITEMS_TABLE=affiliate_items
ITEMS_ID_COLUMN=id
ITEMS_MODEL_COLUMN=model3d_url

# Throughput / safety
PORT=8080
MAX_CONCURRENT=3
MAX_IMAGE_BYTES=12582912
FETCH_TIMEOUT_MS=20000
TEMPLATE_DIR=./templates
MAX_TEXTURE_SIZE=1024
