# Copy to .env and fill in. NEVER commit .env. Rotate any key ever pasted in plaintext.

PORT=4242

# RevenueCat — https://app.revenuecat.com → project settings
# Secret REST API key (server-side only). Used to verify subscriber entitlement.
REVENUECAT_API_KEY=sk_xxx
# Entitlement identifier configured in RevenueCat (e.g. "pro").
REVENUECAT_ENTITLEMENT_ID=pro
# Shared secret set on the RevenueCat webhook (sent as the Authorization header).
REVENUECAT_WEBHOOK_AUTH=changeme

# Public base URL of THIS backend (for provider webhooks; use an ngrok/tunnel URL locally).
PUBLIC_BASE_URL=http://localhost:4242

# Supabase — DEDICATED Snapstyle project (its own auth/storage/db). Settings → API.
SUPABASE_URL=https://xxxx.supabase.co        # Snapstyle project URL
SUPABASE_SERVICE_ROLE_KEY=   # service-role key (secret, server-only, bypasses RLS)
# Direct Postgres connection string (Settings → Database → Connection string → URI).
# Only needed to let the setup script run the migration + create buckets automatically.
SUPABASE_DB_URL=   # postgresql://postgres:<pw>@db.xxxx.supabase.co:5432/postgres

# fal.ai — https://fal.ai/dashboard/keys (Virtual Try-On)
FAL_KEY=
FAL_TRYON_MODEL=fal-ai/idm-vton

# Gemini (server-side only). Roll a fresh key at https://aistudio.google.com/apikey
# — the one shared in chat is compromised.
GEMINI_API_KEY=
# Critique tier (fast) + body-profiling tier (deep vision).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PROFILE=gemini-2.5-pro
