---
import Layout from "../layouts/Layout.astro";
import Screen from "../components/Screen.astro";
import StoreButtons from "../components/StoreButtons.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Looktok",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS",
  description: "An honest, specific read on how your outfit actually looks — from one photo.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
// Every visual on this page is the FOUNDER's real photo + Looktok's actual
// renders of it — no stock models anywhere. The proof IS the product.
const acts = [
  { n: "01", title: "Snap your outfit", body: "One full-length photo. No quiz, no measurements to type in.", src: "/img/founder-before.webp", alt: "The founder's real mirror selfie in a fitting room: black sleeveless top, beige shorts, flip-flops.", tk: "home.act1_t", bk: "home.act1_b" },
  { n: "02", title: "Get the honest read", body: "It names fit, proportion, footwear, layering and colour — one line, with a rating out of five.", src: "/img/founder-now.webp", alt: "The same outfit isolated onto a clean studio background — the avatar Looktok reads and rates.", tk: "home.act2_t", bk: "home.act2_b" },
  { n: "03", title: "Restyle it on you", body: "Swap a piece and see the better version rendered on your own photo — not a model.", src: "/img/founder-sport.webp", alt: "The founder restyled into a sport-luxe look — navy track jacket, joggers and white sneakers, rendered on his own photo.", tk: "home.act3_t", bk: "home.act3_b" },
];
---

<Layout
  title="Looktok — an honest read on your outfit, from one photo"
  description="Snap your outfit. Get a specific read on fit, proportion, footwear, layering and colour — with a rating out of five — then a better version styled on your own photo."
  path="/"
  schema={schema}
>
  <!-- HERO -->
  <section class="hero section">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="label label--sig" data-i18n="home.hero_eyebrow">Your AI stylist</span>
        <h1 class="display" data-i18n="home.hero_h1">Perfect style.<br /><span class="grad">Zero doubt.</span></h1>
        <p class="lead" data-i18n="home.hero_lead">New pieces, rendered on your own body — not on a model. The whole look adapts to how you're built. One photo is enough.</p>
        <StoreButtons />
        <form class="wl" novalidate>
          <input class="wl__email" type="email" required autocomplete="email"
                 placeholder="you@email.com" data-i18n-ph="home.wl_ph"
                 aria-label="Email for early access" />
          <button class="wl__btn" type="submit" data-i18n="home.wl_btn">Get early access</button>
          <p class="wl__note" data-i18n="home.wl_note">Be first when Looktok lands on iOS. No spam — one launch email.</p>
        </form>
      </div>
      <div class="hero__shot reveal">
        <!-- Ghost marquee — brand-register flourish, strictly behind the card. -->
        <div class="ghostwrap" aria-hidden="true">
          <span class="ghost">RESTYLED&ensp;·&ensp;RESTYLED&ensp;·&ensp;RESTYLED&ensp;·&ensp;</span>
          <span class="ghost">RESTYLED&ensp;·&ensp;RESTYLED&ensp;·&ensp;RESTYLED&ensp;·&ensp;</span>
        </div>
        <!-- Interactive proof: DRAG the divider to reveal Looktok's actual
             render over the founder's real fitting-room photo. The chips swap
             which look the divider reveals. No stock model anywhere. -->
        <div class="cmpcol">
          <div class="cmp" id="cmp">
            <img class="cmp__img" src="/img/founder-before.webp" alt="The founder's real mirror selfie in a fitting room." loading="eager" decoding="async" fetchpriority="high" />
            <div class="cmp__afterwrap" aria-hidden="true">
              <img class="cmp__img" id="cmpAfter" src="/img/founder-luxe.webp" alt="" loading="eager" decoding="async" fetchpriority="high" />
            </div>
            <div class="cmp__bar" aria-hidden="true">
              <span class="cmp__knob">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M8.5 7 4 12l4.5 5M15.5 7 20 12l-4.5 5"/></svg>
              </span>
            </div>
            <span class="cmp__tag cmp__tag--l">The photo</span>
            <span class="cmp__tag cmp__tag--r">Restyled on him</span>
            <input class="cmp__range" type="range" min="0" max="100" value="50" step="0.1" aria-label="Drag to reveal the restyled look over the original photo" />
          </div>
          <div class="cmp__chips" role="group" aria-label="Choose the look to reveal">
            <button class="chip is-on" type="button" data-look="/img/founder-luxe.webp">Quiet luxury</button>
            <button class="chip" type="button" data-look="/img/founder-sport.webp">Sport-luxe</button>
            <button class="chip" type="button" data-look="/img/founder-after.webp">Linen</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section">
    <div class="wrap narrow reveal">
      <span class="label" data-i18n="home.problem_label">The problem</span>
      <p class="h2 problem" data-i18n="home.problem">Mirrors, the group chat and generic style quizzes all tell you something. None of them tell you <span class="serif">what to change.</span></p>
    </div>
  </section>

  <!-- CORE LOOP -->
  <section class="section loop">
    <div class="wrap">
      <span class="label reveal" data-i18n="home.loop_label">The loop</span>
      <h2 class="h1 reveal" data-i18n="home.loop_h">Three steps. One straight answer.</h2>
      <div class="acts">
        {acts.map((a) => (
          <div class="act reveal">
            <Screen src={a.src} alt={a.alt} />
            <div class="act__t">
              <span class="label label--sig">{a.n}</span>
              <h3 class="h2" data-i18n={a.tk}>{a.title}</h3>
              <p class="muted" data-i18n={a.bk}>{a.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTIONED EDITOR (differentiator) -->
  <section class="section feature feature--dark">
    <div class="wrap feature__grid">
      <div class="reveal">
        <span class="label label--sig" data-i18n="home.editor_label">The editor</span>
        <h2 class="h1" style="color:var(--on-ink)" data-i18n="home.editor_h">Change one piece.<br />See it on you.</h2>
        <p class="lead" style="color:#C9C9C4" data-i18n="home.editor_lead">Pick a slot — top, bottom, shoes, accessories — and cycle alternatives. Each swap renders on your own photo, so you judge the real thing, not a mood board.</p>
        <p class="label" style="margin-top:var(--s-2)" data-i18n="home.editor_note">Styling ideas — with the brands to shop later</p>
      </div>
      <div class="feature__shots reveal">
        <Screen src="/img/founder-luxe.webp" alt="The founder's own render in a quiet-luxury look — black knit polo, pleated trousers, loafers — one editor pass away from his original outfit." max="270px" />
      </div>
    </div>
  </section>

  <!-- SHOPPING MODE -->
  <section class="section feature">
    <div class="wrap feature__grid feature__grid--rev">
      <div class="feature__shots reveal">
        <Screen src="/img/shopping.webp" alt="Digital wardrobe: your clothes as clean product shots, organized by category." />
      </div>
      <div class="reveal">
        <span class="label label--sig" data-i18n="home.shop_label">Digital wardrobe</span>
        <h2 class="h1" data-i18n="home.shop_h">Your closet,<br />digitized.</h2>
        <p class="lead" data-i18n="home.shop_lead">Add the clothes you own — Looktok turns each piece into a clean product shot and builds looks from what's already in your closet.</p>
      </div>
    </div>
  </section>

  <!-- TRUSTWORTHY -->
  <section class="section">
    <div class="wrap">
      <span class="label reveal" data-i18n="home.trust_label">Why the read is trustworthy</span>
      <h2 class="h1 reveal" data-i18n="home.trust_h">Proof, not adjectives.</h2>
      <div class="trust">
        <div class="trust__i reveal"><h3 class="h2" data-i18n="home.trust1_t">You first, brands second</h3><p class="muted" data-i18n="home.trust1_b">The verdict is about you — your build, your palette, your wardrobe. Brands enter only when a piece genuinely fits the look.</p></div>
        <div class="trust__i reveal"><h3 class="h2" data-i18n="home.trust2_t">Specific, not cruel</h3><p class="muted" data-i18n="home.trust2_b">A sharp friend, not a troll and not a flatterer. It leads with what works.</p></div>
        <div class="trust__i reveal"><h3 class="h2" data-i18n="home.trust3_t">Every note ships a fix</h3><p class="muted" data-i18n="home.trust3_b">No critique without a concrete, wearable way to make it better.</p></div>
        <div class="trust__i reveal"><h3 class="h2" data-i18n="home.trust4_t">A rating out of five</h3><p class="muted" data-i18n="home.trust4_b">Five stars for a look that lands, fewer when it doesn't — one honest read.</p></div>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF — real early-user quotes -->
  <section class="section">
    <div class="wrap">
      <span class="label reveal" data-i18n="home.social_label">Early users</span>
      <h2 class="h1 reveal" data-i18n="home.social_h">What early users say.</h2>
      <div class="voices">
        <figure class="voice reveal">
          <span class="voice__mark" aria-hidden="true">&#8220;</span>
          <blockquote>I clicked through the whole thing in one sitting and just wanted more looks. Now I save outfits for the next time I go shopping.</blockquote>
          <figcaption class="voice__by">
            <span class="voice__ava" aria-hidden="true">V</span>
            <span class="voice__id"><b>Victoria</b><small>Plans her next buys</small></span>
          </figcaption>
        </figure>
        <figure class="voice reveal">
          <span class="voice__mark" aria-hidden="true">&#8220;</span>
          <blockquote>I'm not much of a shopper. Now I can build looks from my small wardrobe without the fuss — I even know what to wash before the weekend so I've got something for the pub.</blockquote>
          <figcaption class="voice__by">
            <span class="voice__ava" aria-hidden="true">E</span>
            <span class="voice__id"><b>Edward</b><small>Dresses from a small wardrobe</small></span>
          </figcaption>
        </figure>
        <figure class="voice reveal">
          <span class="voice__mark" aria-hidden="true">&#8220;</span>
          <blockquote>I've put together genuinely fun looks — for the gym, trips into town, even walking the dog. I'll admit it: I got hooked.</blockquote>
          <figcaption class="voice__by">
            <span class="voice__ava" aria-hidden="true">K</span>
            <span class="voice__id"><b>Konstantin</b><small>Gym, city, dog walks</small></span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section pricing" id="pricing">
    <div class="wrap">
      <span class="label label--sig reveal" data-i18n="home.pr_label">Pricing</span>
      <h2 class="h1 reveal" data-i18n="home.pr_h">Start free. Go Pro when it clicks.</h2>
      <div class="plans">
        <div class="plan reveal">
          <h3 class="plan__name" data-i18n="home.pr_free_name">Free</h3>
          <p class="plan__price">$0</p>
          <p class="plan__note" data-i18n="home.pr_free_note">Everything you need to try the read.</p>
          <ul class="plan__perks">
            <li data-i18n="home.pr_free_1">10 honest style reviews</li>
            <li data-i18n="home.pr_free_2">Looks rendered on your own photo</li>
            <li data-i18n="home.pr_free_3">Digital wardrobe</li>
          </ul>
          <a href="#get" class="btn btn--ghost" data-i18n="cta.get">Get the app</a>
        </div>
        <div class="plan plan--pro reveal">
          <span class="plan__chip" data-i18n="home.pr_chip">Most popular</span>
          <h3 class="plan__name" data-i18n="home.pr_pro_name">Pro</h3>
          <p class="plan__price">$12.99<i>/mo</i></p>
          <p class="plan__note" data-i18n="home.pr_pro_note">or $89.99/year — about $7.50 a month.</p>
          <ul class="plan__perks">
            <li data-i18n="home.pr_pro_1">Unlimited reviews &amp; looks</li>
            <li data-i18n="home.pr_pro_2">Compare two looks side by side</li>
            <li data-i18n="home.pr_pro_3">Brand picks to shop later</li>
            <li data-i18n="home.pr_pro_4">Every future Pro feature, included</li>
          </ul>
          <a href="#get" class="btn" data-i18n="cta.get">Get the app</a>
        </div>
        <div class="plan plan--prem reveal">
          <span class="plan__chip plan__chip--prem" data-i18n="home.pr_prem_chip">New</span>
          <h3 class="plan__name" data-i18n="home.pr_prem_name">Premium</h3>
          <p class="plan__price">$19.99<i>/mo</i></p>
          <p class="plan__note" data-i18n="home.pr_prem_note">Everything in Pro — plus the finishing touches.</p>
          <ul class="plan__perks">
            <li data-i18n="home.pr_prem_1">Fit controls — tucked or untucked, sleeves rolled, jacket open</li>
            <li data-i18n="home.pr_prem_2">Accessory studio — glasses, bag, hat &amp; jewelry as separate swaps</li>
            <li data-i18n="home.pr_prem_3">First in line for every new feature</li>
            <li data-i18n="home.pr_prem_4">Everything in Pro, included</li>
          </ul>
          <a href="#get" class="btn btn--ghost" data-i18n="cta.get">Get the app</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section cta">
    <div class="wrap reveal cta__wrap">
      <h2 class="display cta__h" data-i18n="home.cta_h">Dress like someone<br />told you the truth.</h2>
      <form class="wl wl--center" novalidate>
        <input class="wl__email" type="email" required autocomplete="email"
               placeholder="you@email.com" data-i18n-ph="home.wl_ph"
               aria-label="Email for early access" />
        <button class="wl__btn" type="submit" data-i18n="home.wl_btn">Get early access</button>
      </form>
      <StoreButtons align="center" />
    </div>
  </section>
</Layout>

<script>
  // Waitlist: anon INSERT into Supabase (publishable key — client-safe; RLS
  // allows insert only). Duplicate email (409) counts as success.
  const WL_URL = "https://tnirnwapfgckfypvtooj.supabase.co/rest/v1/waitlist";
  const WL_KEY = "sb_publishable_8yawFqHKS1GeGXbrZC2nEQ_eOI51akc";
  document.querySelectorAll("form.wl").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = form.querySelector(".wl__email") as HTMLInputElement;
      const btn = form.querySelector(".wl__btn") as HTMLButtonElement;
      const email = input.value.trim();
      if (!email || !input.checkValidity()) { input.focus(); return; }
      btn.disabled = true;
      try {
        const r = await fetch(WL_URL, {
          method: "POST",
          headers: {
            apikey: WL_KEY,
            Authorization: `Bearer ${WL_KEY}`,
            "Content-Type": "application/json",
            Prefer: "return=minimal",
          },
          body: JSON.stringify({ email, locale: document.documentElement.lang || "en" }),
        });
        if (r.ok || r.status === 409) {
          form.classList.add("is-done");
          const ok = document.createElement("p");
          ok.className = "wl__ok";
          ok.textContent = form.dataset.ok || "You're in — we'll email you at launch.";
          form.prepend(ok);
        } else {
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  });
</script>

<script>
  // Comparison slider: the invisible full-size range drives the reveal — one
  // pointer surface, native drag + keyboard for free. By default the divider
  // GLIDES on its own (slow sine sweep); any pointer takes over instantly and
  // the glide resumes from the current spot after a moment of quiet.
  const cmp = document.getElementById("cmp");
  if (cmp) {
    const range = cmp.querySelector(".cmp__range") as HTMLInputElement;
    const setX = (v: number | string) => cmp.style.setProperty("--x", v + "%");

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let auto = !reduced;
    let resumeT: ReturnType<typeof setTimeout>;
    let phase = 0;
    let t0 = performance.now();
    const AMP = 30, MID = 50, PERIOD = 6000;
    const tick = (now: number) => {
      if (auto) {
        phase += ((now - t0) / PERIOD) * Math.PI * 2;
        const v = MID + AMP * Math.sin(phase);
        range.value = String(v);
        setX(v);
      }
      t0 = now;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    const pause = () => {
      auto = false;
      clearTimeout(resumeT);
    };
    const scheduleResume = (ms: number) => {
      if (reduced) return;
      clearTimeout(resumeT);
      resumeT = setTimeout(() => {
        // Re-enter the sine AT the current position — no jump on resume.
        const v = parseFloat(range.value);
        phase = Math.asin(Math.max(-1, Math.min(1, (v - MID) / AMP)));
        auto = true;
      }, ms);
    };
    cmp.addEventListener("pointerenter", pause);
    cmp.addEventListener("pointerleave", () => scheduleResume(900));
    cmp.addEventListener("pointerup", () => scheduleResume(2500)); // touch: no pointerleave
    range.addEventListener("input", () => {
      pause();
      setX(range.value);
    });

    const after = document.getElementById("cmpAfter") as HTMLImageElement;
    document.querySelectorAll<HTMLButtonElement>(".cmp__chips .chip").forEach((b) => {
      b.addEventListener("click", () => {
        after.src = b.dataset.look!;
        document.querySelectorAll(".cmp__chips .chip").forEach((x) => x.classList.toggle("is-on", x === b));
      });
    });
  }
</script>

<style>
  .hero { padding-top: clamp(var(--s-5), 5vw, var(--s-7)); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--s-5); align-items: center; }
  .hero__copy .label { display: block; margin-bottom: var(--s-2); }
  .hero .lead { margin-top: var(--s-3); }
  .hero .stores { margin-top: var(--s-4); }
  .hero__shot { display: flex; justify-content: center; }

  /* Hero display: monumental, ultra-tight, deep-graphite gradient — the
     whole block reads as one sculpted object across all 9 locales. */
  .hero .display {
    font-size: clamp(3rem, 2.1rem + 4.6vw, 5.5rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    background: linear-gradient(135deg, #0F0F11 0%, #33332F 55%, #56564F 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* Subtitle: medium weight, muted, elegant measure — never a full-width run. */
  .hero .lead {
    max-width: 36ch;
    font-size: clamp(1.0625rem, 0.98rem + 0.55vw, 1.375rem);
    font-weight: 500;
    color: var(--muted);
  }
  /* Let the copy breathe before the store buttons. */
  .hero .stores { margin-top: var(--s-5); }
  /* Diffuse glow behind the text block — pops it off the page texture. */
  .hero__copy { position: relative; }
  .hero__copy::before {
    content: ""; position: absolute; inset: -14% -20%; z-index: -1;
    background: radial-gradient(50% 44% at 36% 40%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 72%);
    filter: blur(8px); pointer-events: none;
  }

  /* Ghost marquee — ultra-slow infinite tracker, strictly behind the card. */
  .hero__shot { position: relative; }
  .ghostwrap {
    position: absolute; top: -0.4em; left: -30%; right: -10%;
    display: flex; overflow: hidden; z-index: 0; pointer-events: none;
  }
  .ghost {
    flex: none; white-space: nowrap;
    font-size: clamp(84px, 11vw, 150px); font-weight: 900; line-height: 1;
    letter-spacing: -0.04em; color: transparent; user-select: none;
    -webkit-text-stroke: 1.5px rgba(10, 10, 10, 0.08);
    animation: ghostSlide 60s linear infinite;
  }
  @keyframes ghostSlide { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .ghost { animation: none; } }

  /* Interactive comparison slider — drag the divider to reveal the render. */
  .cmpcol { position: relative; z-index: 1; display: flex; flex-direction: column; gap: var(--s-2); align-items: center; width: min(400px, 100%); }
  .cmp {
    --x: 50%;
    position: relative; width: 100%; aspect-ratio: 3 / 4.1;
    border-radius: var(--radius-lg); overflow: hidden; background: #fff;
    box-shadow: 0 30px 60px -24px rgba(10, 10, 10, 0.35);
  }
  .cmp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cmp__afterwrap { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--x)); }
  .cmp__bar {
    position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px;
    transform: translateX(-50%); background: #fff;
    box-shadow: 0 0 0 0.5px rgba(10, 10, 10, 0.18);
  }
  .cmp__knob {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 38px; height: 38px; border-radius: 50%;
    display: grid; place-items: center;
    background: #fff; color: var(--ink);
    box-shadow: 0 6px 18px -4px rgba(10, 10, 10, 0.35), 0 0 0 1px rgba(10, 10, 10, 0.08);
  }
  .cmp__range {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; cursor: ew-resize; margin: 0; -webkit-appearance: none; appearance: none;
  }
  .cmp__tag {
    position: absolute; top: 12px;
    font-size: 0.625rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 4px 9px; border-radius: 999px; pointer-events: none;
  }
  .cmp__tag--l { left: 12px; background: rgba(255, 255, 255, 0.85); color: var(--muted); backdrop-filter: blur(6px); }
  .cmp__tag--r { right: 12px; background: rgba(10, 10, 10, 0.78); color: #fff; backdrop-filter: blur(6px); }
  .cmp__chips { display: flex; gap: 8px; }
  .chip {
    font: inherit; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.02em;
    padding: 7px 14px; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--ink);
    border: 1px solid var(--line); transition: all 0.15s var(--ease);
  }
  .chip:hover { border-color: var(--ink); }
  .chip.is-on { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }

  .store { display: inline-flex; flex-direction: column; line-height: 1.15; background: var(--ink); color: var(--on-ink); padding: 11px 20px; border-radius: var(--radius); }
  .store strong { font-size: 1rem; font-weight: 700; }
  .store small { color: #B9B9B4; font-size: 0.75rem; }
  .store--onink { background: var(--on-ink); color: var(--ink); }
  .store--onink small { color: var(--muted); }
  .store__note { display: block; margin-top: 10px; color: var(--muted); font-size: var(--t-small); }

  .narrow { max-width: 780px; }
  .problem { font-weight: var(--w-black); letter-spacing: -0.02em; line-height: 1.12; margin-top: var(--s-2); }

  .loop .h1 { margin-top: var(--s-1); margin-bottom: var(--s-5); }
  .acts { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); }
  .act { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); text-align: center; }
